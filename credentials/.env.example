# Raspberry Pi 4 Connection
# IP адрес Raspberry Pi
RPI_HOST=192.168.10.45
RPI_PORT=22
RPI_USER=Andrey
RPI_PASSWORD=YOUR_PASSWORD_HERE  # Замените на реальный пароль

# Docker on Raspberry Pi
DOCKER_HOST=ssh://Andrey@192.168.10.45:22

# Portainer (НЕ ПУБЛИКОВАТЬ!)
# HTTPS доступ через веб-интерфейс
PORTAINER_URL=https://192.168.10.45:9443
PORTAINER_ADMIN=admin
PORTAINER_PASSWORD=YOUR_PORTAINER_PASSWORD_HERE  # Замените на реальный пароль

# ============================================
# MediaMTX Configuration
# ============================================
# MediaMTX RTSP Server
# See: https://github.com/bluenviron/mediamtx
# RTSP Port: 8554
# HLS Port: 8890
# WebRTC Port: 8889
MEDIA_URL=rtsp://localhost:8554/all
MEDIA_HLS_URL=http://localhost:8890/all/playlist.m3u8
