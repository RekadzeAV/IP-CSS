JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
DB_PASSWORD=replace-with-strong-db-password-at-least-16-chars
REDIS_PASSWORD=replace-with-strong-redis-password-at-least-16-chars

# Runtime
ENVIRONMENT=production
NODE_ENV=production
HTTP_PORT=8080
HOST=0.0.0.0
FORCE_HTTPS=true
# Set true when HTTPS is terminated by trusted reverse proxy (nginx/traefik/LB)
ALLOW_EXTERNAL_TLS_TERMINATION=true
ENABLE_FLYWAY=true
DB_MODE=postgres
AUDIT_PERSIST_ENABLED=true

# PostgreSQL (required when ENVIRONMENT=production)
DATABASE_URL=jdbc:postgresql://localhost:5432/surveillance
DATABASE_USER=surveillance
DATABASE_PASSWORD=change-me-db-password

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Desktop live-view telemetry tuning (optional)
# Reduce noisy UI updates in multi-camera grids (9/16)
IPCSS_METRICS_PUBLISH_MIN_INTERVAL_MS=1000
IPCSS_METRICS_RENDER_FPS_DELTA=2
IPCSS_METRICS_DROPPED_DELTA=5

# Desktop RTSP staggered connect tuning (optional)
# Helps avoid connect storm on GRID_9/16 cold starts
IPCSS_RTSP_STAGGER_NORMAL_BASE_MS=120
IPCSS_RTSP_STAGGER_NORMAL_JITTER_MS=240
IPCSS_RTSP_STAGGER_BACKGROUND_BASE_MS=450
IPCSS_RTSP_STAGGER_BACKGROUND_JITTER_MS=500
