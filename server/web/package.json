{
  "name": "ip-camera-surveillance-web",
  "version": "Alfa-0.1.1",
  "description": "Web interface for IP Camera Surveillance System",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@reduxjs/toolkit": "^2.2.7",
    "axios": "^1.7.7",
    "date-fns": "^4.1.0",
    "hls.js": "^1.5.12",
    "html2canvas": "^1.4.1",
    "next": "^15.0.3",
    "notistack": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.9",
    "react-hook-form": "^7.53.2",
    "react-player": "^2.16.0",
    "react-redux": "^9.1.2",
    "react-toastify": "^10.0.6",
    "recharts": "^2.12.7",
    "socket.io-client": "^4.7.5",
    "video.js": "^8.10.1",
    "videojs-contrib-quality-levels": "^4.0.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.12.0",
    "eslint-config-next": "^15.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "extract-zip": "^2.0.2"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=3000 NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1 NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ci:acceptance": "npm run build && npm test",
    "lighthouse": "npm run build && npm run start-production & sleep 10 && lighthouse http://localhost:3000 --config-path=./lighthouse.config.js --chrome-flags=\"--headless\" && pkill -f \"next start\"",
    "lighthouse:mobile": "npm run build && npm run start-production & sleep 10 && lighthouse http://localhost:3000 --preset=perf --chrome-flags=\"--headless\" --form-factor=mobile && pkill -f \"next start\"",
    "lighthouse:ci": "npm run build && npm run start-production & sleep 10 && lighthouse http://localhost:3000 --only-categories=performance,accessibility,best-practices --output=json --output-path=./lighthouse-report/report.json && pkill -f \"next start\""
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
