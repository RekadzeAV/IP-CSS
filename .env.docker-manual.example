# Docker Compose manual env — ШАБЛОН (пример). Значения замените на реальные.
# Скопируйте в .env.docker-manual и заполните. НЕ КОММИТИТЬ реальные значения!
DB_PASSWORD=replace-with-strong-db-password-at-least-16-chars
REDIS_PASSWORD=replace-with-strong-redis-password-at-least-16-chars
JWT_SECRET=replace-with-strong-jwt-secret-at-least-32-chars
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
ENVIRONMENT=development
NODE_ENV=development
HTTP_PORT=8080
HOST=0.0.0.0
DB_MODE=postgres
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
AUDIT_PERSIST_ENABLED=false
CAPTCHA_ENABLED=false
ADMIN_PASSWORD=replace-with-admin-password