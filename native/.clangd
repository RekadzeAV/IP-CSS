CompileFlags:
  Add:
    - -I${workspaceFolder}/native/video-processing/include
    - -I${workspaceFolder}/native/video-processing/src
    - -I${workspaceFolder}/native/analytics/include
    - -I${workspaceFolder}/native/analytics/src
    - -I${workspaceFolder}/native/codecs/include
    - -I${workspaceFolder}/native/codecs/src
    - -std=c++17
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wno-unused-parameter
    - -Wno-missing-field-initializers
    - -D_WIN32
    - -DWIN32_LEAN_AND_MEAN
    - -DNOMINMAX
  Remove:
    - -W*
    - -w
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
Index:
  Background: Build
InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
