{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "ENABLE_FFMPEG": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64",
      "description": "Build for Linux x86_64",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux ARM64",
      "description": "Build for Linux ARM64",
      "inherits": "base",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-intel",
      "displayName": "macOS Intel",
      "description": "Build for macOS Intel (x86_64)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon",
      "description": "Build for macOS Apple Silicon (arm64)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Build for Windows x86_64",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "ENABLE_FFMPEG": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release",
      "configurePreset": "linux-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Linux ARM64 Release",
      "configurePreset": "linux-arm64",
      "configuration": "Release"
    },
    {
      "name": "macos-intel-release",
      "displayName": "macOS Intel Release",
      "configurePreset": "macos-intel",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS Apple Silicon Release",
      "configurePreset": "macos-arm64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-x64-tests",
      "displayName": "Linux x64 Tests",
      "configurePreset": "linux-x64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-intel-tests",
      "displayName": "macOS Intel Tests",
      "configurePreset": "macos-intel",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-tests",
      "displayName": "Windows x64 Tests",
      "configurePreset": "windows-x64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
