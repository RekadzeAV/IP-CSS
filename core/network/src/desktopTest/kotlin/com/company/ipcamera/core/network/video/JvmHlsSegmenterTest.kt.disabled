package com.company.ipcamera.core.network.video

import kotlinx.coroutines.runBlocking
import org.junit.Ignore
import kotlin.test.Test
import kotlin.test.*
import java.io.File
import java.util.UUID

/**
 * Тесты для [JvmHlsSegmenter].
 * Требуют наличия FFmpeg в системе.
 * 
 * Примечание: Тесты временно отключены из-за проблемы с инициализацией после установки FFmpeg.
 * Требуется дополнительная диагностика.
 */
@Ignore("FFmpeg installed but test initialization failing - requires investigation")
class JvmHlsSegmenterTest {

    private fun cfg(
        fps: Int = 5,
        segmentDurationSec: Int = 1,
        playlistSize: Int = 3
    ) = HlsSegmenterConfig(
        segmentDurationSec = segmentDurationSec,
        playlistSize = playlistSize,
        outputDir = "build/test-hls/${UUID.randomUUID()}",
        useFmp4 = false,
        fps = fps
    )

    @Test
    fun `start and stop`() = runBlocking {
        val c = cfg()
        val seg = JvmHlsSegmenter(c)
        try {
            assertTrue(seg.start("test-1"))
            assertTrue(seg.isActive())
            assertNotNull(seg.getPlaylistPath())
            assertNotNull(seg.getOutputDir())
        } finally {
            seg.stop()
            File(c.outputDir).deleteRecursively()
        }
    }

    @Test
    fun `feed frames generates segments`() = runBlocking {
        val c = cfg(fps = 5, segmentDurationSec = 1) // 5 frames = 1 segment
        val seg = JvmHlsSegmenter(c)
        try {
            seg.start("test-2")
            var count = 0
            seg.setSegmentCallback { count++ }

            val frame = ByteArray(320 * 240 * 3)
            for (i in 0 until 15) {
                seg.feedFrame(frame, 320, 240, i * 200L)
            }

            assertEquals(3, count, "Should have 3 segments from 15 frames at 5fps/1sec")
            seg.stop()

            // После stop должен быть плейлист с ENDLIST
            val plFile = File(seg.getPlaylistPath()!!)
            assertTrue(plFile.exists(), "Playlist should exist after stop")
            val pl = plFile.readText()
            assertTrue(pl.contains("#EXT-X-ENDLIST"), "Should have ENDLIST")
        } finally {
            seg.stop()
            File(c.outputDir).deleteRecursively()
        }
    }

    @Test
    fun `playlist limited size`() = runBlocking {
        val c = cfg(fps = 5, segmentDurationSec = 1, playlistSize = 2)
        val seg = JvmHlsSegmenter(c)
        try {
            seg.start("test-3")
            val frame = ByteArray(320 * 240 * 3)
            for (i in 0 until 30) {
                seg.feedFrame(frame, 320, 240, i * 200L)
            }
            seg.stop()

            val plFile = File(seg.getPlaylistPath()!!)
            assertTrue(plFile.exists(), "Playlist should exist after stop")
            val segLines = plFile.readText().lines().count { it.startsWith("segment_") }
            assertTrue(segLines <= 2, "Max 2 segments in playlist, got $segLines")
        } finally {
            seg.stop()
            File(c.outputDir).deleteRecursively()
        }
    }

    @Test
    fun `stop adds ENDLIST`() = runBlocking {
        val c = cfg(fps = 5, segmentDurationSec = 1)
        val seg = JvmHlsSegmenter(c)
        try {
            seg.start("test-4")
            val frame = ByteArray(320 * 240 * 3)
            for (i in 0 until 10) {
                seg.feedFrame(frame, 320, 240, i * 200L)
            }

            // Проверяем что плейлист создаётся после stop
            assertFalse(File(seg.getPlaylistPath()!!).exists(), "No playlist before first segment")

            seg.stop()

            val pl = File(seg.getPlaylistPath()!!).readText()
            assertTrue(pl.contains("#EXT-X-ENDLIST"), "Should have ENDLIST")
        } finally {
            seg.stop()
            File(c.outputDir).deleteRecursively()
        }
    }

    @Test
    fun `callbacks match segments`() = runBlocking {
        val c = cfg(fps = 5, segmentDurationSec = 1)
        val seg = JvmHlsSegmenter(c)
        try {
            seg.start("test-5")
            var segCount = 0
            var plCount = 0
            seg.setSegmentCallback { segCount++ }
            seg.setPlaylistCallback { plCount++ }

            val frame = ByteArray(320 * 240 * 3)
            for (i in 0 until 20) {
                seg.feedFrame(frame, 320, 240, i * 200L)
            }

            assertTrue(segCount > 0, "At least 1 segment")
            assertEquals(segCount, plCount, "Segments and playlist updates match")
        } finally {
            seg.stop()
            File(c.outputDir).deleteRecursively()
        }
    }
}