<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: запрещаем cleartext traffic в production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Доверяем системным сертификатам -->
            <certificates src="system" />
            <!-- Доверяем пользовательским сертификатам (для debug) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Локальные host'ы для debug/dev: разрешаем cleartext только здесь -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
