# PostgreSQL Configuration for Staging Environment
# Generated: 2026-05-28

# Database Connection
DB_MODE=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/ipcamera_staging
DATABASE_USER=postgres
DATABASE_PASSWORD=secure_password_123

# Flyway Migrations
ENABLE_FLYWAY=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_TABLE=schema_version

# Connection Pool (HikariCP)
HikariCP.maximumPoolSize=10
HikariCP.minimumIdle=5
HikariCP.connectionTimeout=30000
HikariCP.idleTimeout=600000
HikariCP.maxLifetime=1800000

# Logging
logging.level.org.flywaydb=INFO
logging.level.com.ipcamera=INFO
logging.level.org.hibernate.SQL=DEBUG

# Server Configuration
server.port=8080
server.address=0.0.0.0

# Security
security.jwt.secret=your-secret-key-change-in-production
security.jwt.expiration=86400000
security.refresh-token.expiration=604800000

# WebSocket
websocket.enabled=true
websocket.path=/ws

# Video Processing
video.hls.enabled=true
video.hls.segmentDuration=4
video.hls.playlistSize=3
video.screenshot.enabled=true

# Testing
test.mode=false
test.dryRun=false
