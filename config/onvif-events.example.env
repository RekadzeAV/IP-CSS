# ONVIF Events — пример переменных окружения для подписок на события камер
# Скопируйте нужные строки в .env или задайте в окружении сервера API.
# Полное описание: docs/ENVIRONMENT_VARIABLES.md (раздел «ONVIF Events»)

# Включить авто-подписку при старте API и при добавлении камеры (true/false, по умолчанию true)
ONVIF_EVENTS_ENABLED=true

# Время жизни подписки в секундах (по умолчанию 3600, минимум 60)
ONVIF_SUBSCRIPTION_TIME_SEC=3600

# Интервал опроса PullPoint в миллисекундах (по умолчанию 5000, минимум 1000)
ONVIF_PULL_INTERVAL_MS=5000

# Таймаут запроса PullMessages в миллисекундах (по умолчанию 500, диапазон 100–30000)
ONVIF_PULL_TIMEOUT_MS=500

# Использовать PullPoint по умолчанию (true/false, по умолчанию true)
ONVIF_USE_PULL_POINT=true
