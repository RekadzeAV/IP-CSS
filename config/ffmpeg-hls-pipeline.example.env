# FFmpeg / HLS pipeline (1.8.2 live + recordings) — пример переменных для сервера API
# Скопируйте в .env / docker-compose или задайте в systemd Environment=

# RTSP live (HlsGeneratorService live + adaptive): см. server/.../FfmpegCli.kt rtspFfmpegInputArgs
# FFMPEG_RTSP_RW_TIMEOUT_MICROS=10000000
# FFMPEG_RTSP_RW_TIMEOUT_MICROS=0
# FFMPEG_RTSP_STIMEOUT_MICROS=5000000
# FFMPEG_RTSP_STIMEOUT_MICROS=0

# Запись → HLS: ffmpegRecordingToHlsInputFlags() перед -i
# FFMPEG_RECORDING_HLS_GENPTS=1
# FFMPEG_RECORDING_HLS_GENPTS=0
