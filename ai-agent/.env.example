# AI Agent Configuration
# Копируйте этот файл в .env и заполните значения

# ============================================
# LLM PROVIDERS CONFIGURATION
# ============================================

# Primary LLM Provider (Development: LM Studio)
LLM_PROVIDER_PRIMARY=lm-studio
LLM_PRIMARY_BASE_URL=http://localhost:1234/v1
LLM_PRIMARY_MODEL=qwen/qwen2.5-coder-14b
LLM_PRIMARY_API_KEY=lm-studio

# Fallback LLM Provider (Production: Ollama)
LLM_PROVIDER_FALLBACK=ollama
LLM_FALLBACK_BASE_URL=http://localhost:11434
LLM_FALLBACK_MODEL=llama3.1:8b
LLM_FALLBACK_API_KEY=ollama

# Embedding Model Provider
EMBEDDING_PROVIDER=lm-studio
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ============================================
# LLM PARAMETERS
# ============================================
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TOP_P=0.9

# ============================================
# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PASSWORD=chroma_secure_password
CHROMA_COLLECTION=agent_memory

# Redis Configuration (AI-specific)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=ai_redis_secure_password
REDIS_DB=0

# LLM Configuration
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TOP_P=0.9

# Agent Configuration
AGENT_NAME=IP-CSS Agent
AGENT_SYSTEM_PROMPT=You are a helpful AI assistant for IP-CSS surveillance system. You can manage cameras, search events, and help with recordings.

# Security
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
ENABLE_AUTH=true
# Учётные данные демо-логина (замените на сильные!). НЕ храните их в коде.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password-at-least-16-chars

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Memory
MEMORY_MAX_TOKENS=8000
MEMORY_COMPRESSION_THRESHOLD=4000
